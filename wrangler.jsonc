{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amtrak-bike-map",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "amtrak-bike-map.transittools.dev",
      "custom_domain": true
    },
    {
      "pattern": "bikesonamtrak.com",
      "custom_domain": true
    }
  ]
}
